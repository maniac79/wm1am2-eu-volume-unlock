#!/usr/bin/env bash
# Fake adb for host tests. Simulates device state and emits structured result
# records so the host layer can be tested without hardware.
#
# Env: FAKE_STATE_DIR (required), FAKE_DEVICES, FAKE_MODEL, FAKE_FP,
#      FAKE_RESPONSE (ok|read_ok|fatal|abort|incomplete|noout|stale|malformed|dup|truncated)
set -uo pipefail

S="$FAKE_STATE_DIR"
mkdir -p "$S"
printf '%s\n' "$*" >> "$S/calls.log"

DEVICES="${FAKE_DEVICES:-SER123}"
MODEL="${FAKE_MODEL:-NW-WM1AM2}"
FP="${FAKE_FP:-SonyAudio/icx1298_001/icx1298:11/1.09.00/68:user/release-keys}"
RESP="${FAKE_RESPONSE:-ok}"
PKGVER="${FAKE_PKGVER:-1.1.0}"
DEST="${FAKE_DEST:-03010000}"
SAFE="${FAKE_SAFE:-01000000}"

get_setting() {
    if [ -f "$S/setting" ]; then cat "$S/setting"; else echo "null"; fi
}

pad_hex() {   # ascii -> fixed 256-byte hex
    local hx
    hx=$(printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n')
    while [ "${#hx}" -lt 512 ]; do hx="${hx}00"; done
    printf '%s' "$hx"
}

emit_results() {
    local payload="$1" line cls run
    line=$(tail -n 1 "$payload")
    cls=""
    run=""
    local -a toks
    local k
    while IFS= read -r k; do toks+=("$k"); done <<< "$(printf '%s' "$line" | tr ' ' '\n')"
    local n=${#toks[@]}
    for ((k = 0; k < n; k++)); do
        case "${toks[$k]}" in
            org.maniac79.nvptool.*)
                cls="${toks[$k]}"
                run="${toks[$((k + 1))]:-}"
                break
                ;;
        esac
    done

    case "$cls" in
        *Read) id="read" ;;
        *Apply) id="apply" ;;
        *RestoreField) id="restore" ;;
        *RestoreReference) id="restore_reference" ;;
        *) id="unknown" ;;
    esac
    case "$RESP" in
        read_ok) [ "$id" = "read" ] || RESP=ok ;;
    esac

    # Write-path faults must not also break the backup read that precedes them.
    if [ "$id" = "read" ]; then
        RESP="${FAKE_RESPONSE_READ:-$RESP}"
    else
        RESP="${FAKE_RESPONSE_WRITE:-$RESP}"
    fi

    local head="NVPTOOL_RESULT v=1 schema=1 tool=1.1.0 run=$run op=$id"
    begin="$head ev=begin"
    case "$RESP" in
        noout) return 0 ;;
        truncated) printf '%s\n' "$begin" ; return 0 ;;
        stale)  printf '%s\n' "$begin"
                printf 'NVPTOOL_RESULT v=1 schema=1 tool=1.1.0 run=STALE-999 op=%s ev=summary status=OK phase=done written=8 verified=8 total=8 reason=-\n' "$id"
                return 0 ;;
        malformed) printf '%s\n' "$begin"
                printf '%s ev=summary status=BOGUS phase=done written=8 verified=8 total=8 reason=-\n' "$head"
                return 0 ;;
        dup) printf '%s\n' "$begin"
                printf '%s ev=summary status=OK phase=done written=8 verified=8 total=8 reason=-\n' "$head"
                printf '%s ev=summary status=OK phase=done written=8 verified=8 total=8 reason=-\n' "$head"
                return 0 ;;
    esac

    printf '%s\n' "$begin"
    if [ "$id" = "read" ] || [ "$id" = "restore" ]; then
        local i hex
        for i in 0 1 2 3 4 5 6 7; do
            case "$i" in
                0|1) hex=$(pad_hex "${FAKE_S0:-kVolTblIcx1298CewHpSe}") ;;
                2|3) hex=$(pad_hex "${FAKE_S2:-kVolTblIcx1298CewHpBtl}") ;;
                4|5|6) hex="${FAKE_I4:-00000000}" ;;
                7) hex="${FAKE_I7:-01000000}" ;;
            esac
            [ "$id" = "restore" ] && hex="${FAKE_BK_HEX:-$hex}"
            if [ "$i" -lt 4 ]; then
                printf '%s ev=field idx=%s key=%s len=256 val=%s\n' "$head" "$i" "k$i" "$hex"
            else
                printf '%s ev=field idx=%s key=%s len=4 val=%s\n' "$head" "$i" "k$i" "$hex"
            fi
        done
    fi

    case "$RESP" in
        fatal)      printf '%s ev=summary status=FATAL phase=preflight written=0 verified=0 total=8 reason=hal_unavailable\n' "$head" ;;
        abort)      printf '%s ev=summary status=ABORT phase=read written=0 verified=0 total=8 reason=state_changed_since_backup\n' "$head" ;;
        incomplete) printf '%s ev=summary status=INCOMPLETE phase=write written=2 verified=2 total=8 reason=write_failed_2\n' "$head" ;;
        *)          printf '%s ev=summary status=OK phase=done written=8 verified=8 total=8 reason=-\n' "$head" ;;
    esac
}

handle_shell() {
    local line="$*"
    case "$line" in
        *"getprop ro.product.model"*)        echo "$MODEL" ;;
        *"getprop ro.build.fingerprint"*)    echo "$FP" ;;
        *"getprop vendor.destination"*)      echo "$DEST" ;;
        *"getprop vendor.safe_volume.enabled"*) echo "$SAFE" ;;
        *"pm path "*)                        echo "package:/data/app/x/base.apk" ;;
        *"dumpsys package "*)                echo "    versionName=$PKGVER" ;;
        *"test -r "*)                        exit 0 ;;
        *"logcat -d"*)                       [ -f "$S/logcat" ] && cat "$S/logcat" ;;
        *"settings get global hidden_api_blacklist_exemptions"*) get_setting ;;
        *"settings put global hidden_api_blacklist_exemptions"*) : > "$S/logcat" ;;
        *"settings delete global hidden_api_blacklist_exemptions"*) rm -f "$S/setting" ;;
        *"am start"*)                        [ -f "$S/pending" ] && cat "$S/pending" >> "$S/logcat" ;;
        *)                                   : ;;
    esac
}

sub="$1"; shift || true
if [ "$sub" = "devices" ]; then
    printf 'List of devices attached\n'
    for d in $DEVICES; do printf '%s\tdevice\n' "$d"; done
    exit 0
fi
if [ "$sub" = "-s" ]; then
    serial="$1"; shift || true
    printf '%s' "$serial" > "$S/last_serial"
    sub="$1"; shift || true
    if [ "$sub" = "push" ]; then
        cp "$1" "$S/payload.txt" 2>/dev/null || true
        emit_results "$S/payload.txt" > "$S/pending"
        exit 0
    fi
    if [ "$sub" = "shell" ]; then
        handle_shell "$@"
        exit 0
    fi
    exit 0
fi
exit 0
