#!/usr/bin/env bash
# Fake adb for host tests. Simulates device state and emits structured result
# records so the host layer can be tested without hardware.
#
# Env: FAKE_STATE_DIR (required), FAKE_DEVICES, FAKE_MODEL, FAKE_FP,
#      FAKE_RESPONSE (ok|read_ok|fatal|abort|incomplete|noout|stale|malformed|dup|truncated)
set -uo pipefail

S="$FAKE_STATE_DIR"
mkdir -p "$S"
printf '%s\n' "$*" >> "$S/calls.log"

DEVICES="${FAKE_DEVICES:-SER123}"
MODEL="${FAKE_MODEL:-NW-WM1AM2}"
FP="${FAKE_FP:-SonyAudio/icx1298_001/icx1298:11/1.09.00/68:user/release-keys}"
RESP="${FAKE_RESPONSE:-ok}"
PKGVER="${FAKE_PKGVER:-0.2.4}"
DEST="${FAKE_DEST:-03010000}"
SAFE="${FAKE_SAFE:-01000000}"

get_setting() {
    if [ -f "$S/setting" ]; then cat "$S/setting"; else echo "null"; fi
}

has_installed() {
    [ -f "$S/installed" ] || [ "${FAKE_INSTALLED:-1}" != 0 ]
}

pad_hex() {   # ascii -> fixed 256-byte hex
    local hx
    hx=$(printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n')
    while [ "${#hx}" -lt 512 ]; do hx="${hx}00"; done
    printf '%s' "$hx"
}

emit_results() {
    local payload="$1" line cls run
    line=$(tail -n 1 "$payload")
    cls=""
    run=""
    local -a toks
    local k
    while IFS= read -r k; do toks+=("$k"); done <<< "$(printf '%s' "$line" | tr ' ' '\n')"
    local n=${#toks[@]}
    for ((k = 0; k < n; k++)); do
        case "${toks[$k]}" in
            org.maniac79.nvptool.*)
                cls="${toks[$k]}"
                run="${toks[$((k + 1))]:-}"
                break
                ;;
        esac
    done

    case "$cls" in
        *Read) id="read" ;;
        *Apply) id="apply" ;;
        *RestoreField) id="restore" ;;
        *RestoreReference) id="restore_reference" ;;
        *) id="unknown" ;;
    esac
    case "$RESP" in
        read_ok) [ "$id" = "read" ] || RESP=ok ;;
    esac

    # Write-path faults must not also break the backup read that precedes them.
    if [ "$id" = "read" ]; then
        RESP="${FAKE_RESPONSE_READ:-$RESP}"
    else
        RESP="${FAKE_RESPONSE_WRITE:-$RESP}"
    fi

    local head="NVPTOOL_RESULT v=1 schema=1 tool=0.2.4 run=$run op=$id pid=${FAKE_PID:-4201}"
    begin="$head ev=begin"
    case "$RESP" in
        noout) return 0 ;;
        truncated) printf '%s\n' "$begin" ; return 0 ;;
        stale)  printf '%s\n' "$begin"
                printf 'NVPTOOL_RESULT v=1 schema=1 tool=0.2.4 run=STALE-999 op=%s ev=summary status=OK phase=done written=8 verified=8 total=8 reason=-\n' "$id"
                return 0 ;;
        malformed) printf '%s\n' "$begin"
                printf '%s ev=summary status=BOGUS phase=done written=8 verified=8 total=8 reason=-\n' "$head"
                return 0 ;;
        dup) printf '%s\n' "$begin"
                printf '%s ev=summary status=OK phase=done written=8 verified=8 total=8 reason=-\n' "$head"
                printf '%s ev=summary status=OK phase=done written=8 verified=8 total=8 reason=-\n' "$head"
                return 0 ;;
    esac

    printf '%s\n' "$begin"
    # Claim records: the winner reports how it claimed, and a claimed-out
    # duplicate reports that it did nothing.
    if [ "${FAKE_NO_CLAIM:-0}" != "1" ]; then
        printf '%s ev=note msg=claim_acquired mode=file\n' "$head"
    fi
    [ "${FAKE_DUP_SKIPPED:-0}" = "1" ] && \
        printf '%s ev=note msg=duplicate_skipped\n' "$head"
    if [ "$id" = "read" ] || [ "$id" = "restore" ]; then
        local i hex
        local -a sv iv
        if [ "${FAKE_PROFILE:-reference}" = "target" ]; then
            sv=( kVolTblIcx1298HpSeGainHigh kVolTblIcx1298HpSeGainLow \
                 kVolTblIcx1298HpBtlGainHigh kVolTblIcx1298HpBtlGainLow )
            iv=( 1 1 1 0 )
        else
            sv=( kVolTblIcx1298CewHpSe kVolTblIcx1298CewHpSe \
                 kVolTblIcx1298CewHpBtl kVolTblIcx1298CewHpBtl )
            iv=( 0 0 0 1 )
        fi
        for i in 0 1 2 3 4 5 6 7; do
            if [ "$i" -lt 4 ]; then
                hex=$(pad_hex "${sv[$i]}")
            elif [ "${iv[$((i - 4))]}" = "1" ]; then
                hex="01000000"
            else
                hex="00000000"
            fi
            [ "$id" = "restore" ] && hex="${FAKE_BK_HEX:-$hex}"
            if [ "$i" -lt 4 ]; then
                printf '%s ev=field idx=%s key=%s len=256 val=%s\n' "$head" "$i" "k$i" "$hex"
            else
                printf '%s ev=field idx=%s key=%s len=4 val=%s\n' "$head" "$i" "k$i" "$hex"
            fi
        done
    fi

    case "$RESP" in
        fatal)      printf '%s ev=summary status=FATAL phase=preflight written=0 verified=0 total=8 reason=hal_unavailable\n' "$head" ;;
        abort)      printf '%s ev=summary status=ABORT phase=read written=0 verified=0 total=8 reason=state_changed_since_backup\n' "$head" ;;
        incomplete) printf '%s ev=summary status=INCOMPLETE phase=write written=2 verified=2 total=8 reason=write_failed_2\n' "$head" ;;
        *)
            # A read never writes; the host validates that explicitly.
            local w=8
            [ "$id" = "read" ] && w=0
            printf '%s ev=summary status=OK phase=done written=%s verified=8 total=8 reason=-\n' "$head" "$w" ;;
    esac
}

handle_shell() {
    local line="$*"
    case "$line" in
        *"getprop ro.product.model"*)        echo "$MODEL" ;;
        *"getprop ro.build.fingerprint"*)    echo "$FP" ;;
        *"getprop vendor.destination"*)      echo "$DEST" ;;
        *"getprop vendor.safe_volume.enabled"*) echo "$SAFE" ;;
        *"pm path "*)                        has_installed && echo "package:/data/app/x/base.apk" ;;
        *"dumpsys package "*)                echo "    versionName=$PKGVER" ;;
        *"test -r "*)                        exit 0 ;;
        *"mkdir /data/local/tmp/nvptool.lock"*)
            [ -f "$S/remote_lock" ] && exit 1
            : > "$S/remote_lock" ;;
        *" > /data/local/tmp/nvptool.lock/owner"*)
            if [[ "$line" =~ \'([0-9-]+)\' ]]; then
                printf '%s' "${BASH_REMATCH[1]}" > "$S/remote_owner"
            else
                exit 1
            fi ;;
        *"cat /data/local/tmp/nvptool.lock/owner"*)
            [ -f "$S/remote_owner" ] && cat "$S/remote_owner" || exit 1 ;;
        *"rmdir /data/local/tmp/nvptool.lock"*)
            rm -f "$S/remote_owner" "$S/remote_lock" ;;
        *"logcat -d"*)
            # FAKE_DUP_LATE=1 simulates a SECOND execution whose records only
            # reach the buffer after the host has already seen the first
            # summary. That is exactly the case an early snapshot cannot see.
            if [ -f "$S/pending_late" ]; then
                n=$(( $(cat "$S/lc_reads" 2>/dev/null || echo 0) + 1 ))
                printf '%s' "$n" > "$S/lc_reads"
                if [ "$n" -ge 2 ]; then
                    cat "$S/pending_late" >> "$S/logcat"
                    rm -f "$S/pending_late"
                fi
            fi
            [ -f "$S/logcat" ] && cat "$S/logcat" ;;
        *"settings list global"*)
            [ "${FAKE_SETTINGS_LIST_FAIL:-0}" = 1 ] && exit 1
            [ -f "$S/setting" ] && printf 'hidden_api_blacklist_exemptions=%s\n' "$(cat "$S/setting")" ;;
        *"settings get global hidden_api_blacklist_exemptions"*)
            [ "${FAKE_SETTINGS_GET_FAIL:-0}" = 1 ] && exit 1
            get_setting ;;
        *"settings put global hidden_api_blacklist_exemptions"*)
            case "$line" in
                *'$(cat'*)   # payload install: mutates the setting
                    printf 'NVPTOOL-PAYLOAD' > "$S/setting"
                    : > "$S/logcat"
                    ;;
                *)           # restore: put the original value back
                    v="${line#*hidden_api_blacklist_exemptions }"
                    v="${v#\"}"; v="${v%\"}"
                    if [ "${FAKE_SETTINGS_RESTORE_FAIL:-0}" = "1" ]; then
                        :
                    else
                        printf '%s' "$v" > "$S/setting"
                    fi
                    ;;
            esac
            ;;
        *"settings delete global hidden_api_blacklist_exemptions"*)
            if [ "${FAKE_SETTINGS_RESTORE_FAIL:-0}" = "1" ]; then
                :
            else
                rm -f "$S/setting"
            fi
            ;;
        *"am start"*)                        [ -f "$S/pending" ] && cat "$S/pending" >> "$S/logcat" ;;
        *)                                   : ;;
    esac
}

sub="$1"; shift || true
if [ "$sub" = "devices" ]; then
    printf 'List of devices attached\n'
    for d in $DEVICES; do printf '%s\tdevice\n' "$d"; done
    exit 0
fi
if [ "$sub" = "-s" ]; then
    serial="$1"; shift || true
    printf '%s' "$serial" > "$S/last_serial"
    sub="$1"; shift || true
    if [ "$sub" = "install" ]; then
        cp "${@: -1}" "$S/installed.apk" || exit 1
        : > "$S/installed"
        echo 'Success'
        exit 0
    fi
    if [ "$sub" = "pull" ]; then
        src="$1"; dst="$2"
        [ "$src" = /data/app/x/base.apk ] || exit 1
        cp "${FAKE_INSTALLED_APK:-${S}/installed.apk}" "$dst" 2>/dev/null || \
            cp "${NVPTOOL_APK:-}" "$dst" 2>/dev/null || exit 1
        exit 0
    fi
    if [ "$sub" = "push" ]; then
        cp "$1" "$S/payload.txt" 2>/dev/null || true
        emit_results "$S/payload.txt" > "$S/pending"
        # A second execution of the same request, reported with a different pid.
        # It is only released into the buffer after the host has seen the first
        # summary, which is what FAKE_DUP_LATE=1 reproduces.
        if [ "${FAKE_DUP_LATE:-0}" = "1" ]; then
            FAKE_PID="${FAKE_PID2:-4202}" emit_results "$S/payload.txt" > "$S/pending_late"
            rm -f "$S/lc_reads"
        fi
        exit 0
    fi
    if [ "$sub" = "shell" ]; then
        handle_shell "$@"
        exit 0
    fi
    exit 0
fi
exit 0
